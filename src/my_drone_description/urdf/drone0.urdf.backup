<?xml version="1.0"?>
<!-- This URDF was automatically created by SolidWorks to URDF Exporter! -->
<!-- Modified for Gazebo compatibility -->
<robot name="my_drone">
  <!-- 添加基础参数 -->
  <material name="red_plastic">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>
  
  <material name="blue_plastic">
    <color rgba="0.79216 0.81961 0.93333 1.0"/>
  </material>
  
  <!-- 基础链接 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0055704807018409 -0.00244991967294366 -0.0185497134505628" rpy="0 0 0" />
      <mass value="0.5" /> <!-- 增加质量使其更稳定 -->
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_drone_description/meshes/base_link.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="red_plastic" />
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.05 0.05" /> <!-- 简化碰撞体 -->
      </geometry>
    </collision>
  </link>
  
  <!-- 第一个连接臂 -->
  <link name="link0">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" /> <!-- 合理的质量 -->
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_drone_description/meshes/link0.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="blue_plastic" />
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.1" radius="0.005" />
      </geometry>
    </collision>
  </link>
  
  <joint name="joint0" type="revolute">
    <origin xyz="0.022417 0.016751 0.0097501" rpy="-1.5708 0 1.3255" />
    <parent link="base_link" />
    <child link="link0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="3.0" />
    <dynamics damping="0.7" friction="0.0" />
  </joint>
  
  <!-- 第二个连接臂 -->
  <link name="link1">
    <inertial>
