<?xml version="1.0"?>
<robot name="my_drone">
  <!-- 添加基础参数 -->
  <material name="gray_plastic">
    <color rgba="0.89804 0.91765 0.92941 1"/>
  </material>
  
  <material name="white_plastic">
    <color rgba="1 1 1 1"/>
  </material>
  
  <material name="dark_gray_plastic">
    <color rgba="0.698039215686274 0.698039215686274 0.698039215686274 1"/>
  </material>
  
  <!-- 基础链接 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.18589 0.025385 -0.089702" rpy="0 0 0" />
      <mass value="0.23946" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
    
    <visual>
      <origin xyz="0 0 1" rpy="0 0 1" />
      <geometry>
        <!-- 使用成功的路径格式和缩放比例 -->
        <mesh filename="file:///home/user-888/dh_robot_ws/src/my_drone_description/meshes/base_link.STL" scale="10 10 10" />
      </geometry>
      <material name="gray_plastic" />
    </visual>
    
    <collision>
      <origin xyz="0 0 1" rpy="0 0 1" />
      <geometry>
        <box size="0.3 0.2 0.18" />
      </geometry>
    </collision>
  </link>
  
  <!-- Yaw链接 -->
  <link name="yaw">
    <inertial>
      <origin xyz="0.0103797833080959 0.0287441623641597 -0.0220050146216159" rpy="0 0 0" />
      <mass value="0.51552039381936" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
    
    <visual>
      <origin xyz="0 0 1" rpy="0 0 1" />
      <geometry>
        <!-- 检查这个文件是否真的存在 -->
        <mesh filename="file:///home/user-888/dh_robot_ws/src/my_drone_description/meshes/yaw.STL" scale="10 10 10" />
      </geometry>
      <material name="white_plastic" />
    </visual>
    
    <collision>
      <origin xyz="0 0 1" rpy="0 0 1" />
      <geometry>
        <cylinder length="0.05" radius="0.03" />
      </geometry>
    </collision>
  </link>
  
  <joint name="yaw_joint" type="revolute">
    <origin xyz="0.187289359867794 0.0282155838548886 -0.0646157318421644" rpy="1.57078500751568 0.12526871324495 1.11094022300956" />
    <parent link="base_link" />
    <child link="yaw" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="3.0" />
    <dynamics damping="0.7" friction="0.0" />
  </joint>
  
  <!-- Pitch链接 -->
  <link name="pitch">
    <inertial>
      <origin xyz="-0.0305440015123965 -0.0400157853081023 -0.0206415230666211" rpy="0 0 0" />
      <mass value="0.055219748576844" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    
    <visual>
      <origin xyz="0 0 1" rpy="0 0 1" />
      <geometry>
        <!-- 检查这个文件是否真的存在 -->
        <mesh filename="file:///home/user-888/dh_robot_ws/src/my_drone_description/meshes/pitch.STL" scale="10 10 10" />
      </geometry>
      <material name="dark_gray_plastic" />
    </visual>
    
    <collision>
      <origin xyz="0 0 1" rpy="0 0 1" />
      <geometry>
        <box size="0.08 0.06 0.04" />
      </geometry>
    </collision>
  </link>
  
  <joint name="pitch_joint" type="revolute">
    <origin xyz="0 0.075155010755645 0.0550000144212614" rpy="0 -0.411876936613041 1.57079632679491" />
    <parent link="yaw" />
    <child link="pitch" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="3.0" />
    <dynamics damping="0.7" friction="0.0" />
  </joint>
  
  <!-- Roll链接 -->
  <link name="roll">
    <inertial>
      <origin xyz="0.0116143937393282 -0.00109692153198808 0.016054548772384" rpy="0 0 0" />
      <mass value="0.0730619357471298" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    
    <visual>
      <origin xyz="0 0 1" rpy="0 0 1" />
      <geometry>
        <!-- 检查这个文件是否真的存在 -->
        <mesh filename="file:///home/user-888/dh_robot_ws/src/my_drone_description/meshes/roll.STL" scale="10 10 10" />
      </geometry>
      <material name="dark_gray_plastic" />
    </visual>
    
    <collision>
      <origin xyz="0 0 1" rpy="0 0 1" />
      <geometry>
        <box size="0.04 0.02 0.03" />
      </geometry>
    </collision>
  </link>
  
  <joint name="roll_joint" type="revolute">
    <origin xyz="0 -0.00300002039478578 0" rpy="-3.14159265358979 -0.0819916830560762 1.5707963267949" />
    <parent link="pitch" />
    <child link="roll" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="3.0" />
    <dynamics damping="0.7" friction="0.0" />
  </joint>
  
  <!-- Gazebo扩展配置 -->
  <gazebo reference="base_link">
    <material>Gazebo/Gray</material>
    <turnGravityOff>false</turnGravityOff>
    <transparency>0.0</transparency>
  </gazebo>
  
  <gazebo reference="yaw">
    <material>Gazebo/White</material>
    <transparency>0.0</transparency>
  </gazebo>
  
  <gazebo reference="pitch">
    <material>Gazebo/DarkGray</material>
    <transparency>0.0</transparency>
  </gazebo>
  
  <gazebo reference="roll">
    <material>Gazebo/DarkGray</material>
    <transparency>0.0</transparency>
  </gazebo>
</robot>